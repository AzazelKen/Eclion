  <!-- ========================================================= -->
  <!-- JAVASCRIPT LOGIC & INTERNATIONALIZATION                  -->
  <!-- ========================================================= -->
  <script>
    // --- 1. HERO BACKGROUND SLIDESHOW (17 IMAGES LOOP) ---
    const slides = document.querySelectorAll('.hero-slide');
    let currentSlide = 0;
    function cycleHeroSlides() {
      if (slides.length === 0) return;
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }
    setInterval(cycleHeroSlides, 4000);

    // --- 2. AUDIO PLAYER (`fondo.mp3`) ---
    const bgAudio = document.getElementById('backgroundAudio');
    const audioPlayBtn = document.getElementById('audioPlayBtn');
    const audioPlayIcon = document.getElementById('audioPlayIcon');
    const audioWidget = document.getElementById('audioWidget');
    const audioVolume = document.getElementById('audioVolume');
    const audioToast = document.getElementById('audioToast');
    const enableAudioBtn = document.getElementById('enableAudioBtn');

    bgAudio.volume = parseFloat(audioVolume.value);

    function toggleAudio() {
      if (bgAudio.paused) {
        bgAudio.play().then(() => {
          audioPlayIcon.textContent = '❚❚';
          audioWidget.classList.add('is-playing');
          if (audioToast) audioToast.style.display = 'none';
        }).catch(err => {
          console.warn('Autoplay prevented:', err);
          if (audioToast) audioToast.style.display = 'flex';
        });
      } else {
        bgAudio.pause();
        audioPlayIcon.textContent = '▶';
        audioWidget.classList.remove('is-playing');
      }
    }

    audioPlayBtn.addEventListener('click', toggleAudio);
    if (enableAudioBtn) {
      enableAudioBtn.addEventListener('click', () => {
        toggleAudio();
      });
    }

    audioVolume.addEventListener('input', (e) => {
      bgAudio.volume = parseFloat(e.target.value);
    });

    // Attempt gentle autoplay on first user click anywhere on page
    document.addEventListener('click', function initialAudioUnlock() {
      if (bgAudio.paused && audioToast && audioToast.style.display === 'flex') {
        bgAudio.play().then(() => {
          audioPlayIcon.textContent = '❚❚';
          audioWidget.classList.add('is-playing');
          audioToast.style.display = 'none';
        }).catch(() => {});
      }
      document.removeEventListener('click', initialAudioUnlock);
    }, { once: true });

    // --- 3. TOAST SYSTEM & COPY VRCHAT LINK ---
    function showToast(msg) {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = 'toast-message';
      toast.textContent = msg;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(30px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 3500);
    }

    const copyGroupBtn = document.getElementById('copyGroupBtn');
    copyGroupBtn.addEventListener('click', () => {
      navigator.clipboard.writeText('https://vrc.group/ECL.4481').then(() => {
        showToast('Enlace del Grupo VRChat copiado al portapapeles 📋');
      }).catch(() => {
        showToast('Enlace VRChat: https://vrc.group/ECL.4481');
      });
    });

    // --- 4. SATURDAY COUNTDOWN TIMER ---
    function updateCountdown() {
      const now = new Date();
      // Calculate next Saturday 22:00 CET
      let nextSat = new Date();
      nextSat.setDate(now.getDate() + ((6 - now.getDay() + 7) % 7));
      nextSat.setHours(22, 0, 0, 0);
      if (now > nextSat) {
        nextSat.setDate(nextSat.getDate() + 7);
      }
      const diff = nextSat - now;
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const mins = Math.floor((diff / (1000 * 60)) % 60);
      const secs = Math.floor((diff / 1000) % 60);

      document.getElementById('cdDays').textContent = String(days).padStart(2, '0');
      document.getElementById('cdHours').textContent = String(hours).padStart(2, '0');
      document.getElementById('cdMins').textContent = String(mins).padStart(2, '0');
      document.getElementById('cdSecs').textContent = String(secs).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // --- 5. ARTISTS DATA & MODAL SYSTEM ---
    const artistsData = [
      { name: 'AzazelKen', image: 'https://api.vrchat.cloud/api/1/file/file_98da1e47-010c-47ce-82ff-4ed7fb65af15/1/', genre: 'Hard techno · hardstyle · uptempo · frenchcore · dubstep · gabber', tag: 'FOUNDER / DJ', links: [['YouTube', 'https://www.youtube.com/@AzazelKenDJ'], ['VRC.DJ', 'https://vrc.dj/azazelken']], bio: 'DJ, productor y fundador de ECLION. Creador de la experiencia inmersiva visual, de diseño y estética sonora de la comunidad.' },
      { name: 'Chiquiboo', image: 'https://i.imgur.com/9362Ygo.png', genre: 'Hard industrial techno · hard techno', tag: 'CO-OWNER / DJ', links: [['Twitch', 'https://www.twitch.tv/cakedfaceboo']], bio: 'Co-propietaria de ECLION y DJ residente enfocada en el Industrial Techno duro e hipnótico.' },
      { name: 'Raver_Lulamoon', image: 'https://i.imgur.com/Q0i1anB.png', genre: 'UK hardcore · powerstomp · makina · happy hardcore · trance', tag: 'CO-OWNER / DJ', links: [['YouTube', 'https://www.youtube.com/@RVRDJ']], bio: 'Pionera del UK Hardcore, Makina y Powerstomp con energía pura para la pista de baile.' },
      { name: 'Anal_Rampage', image: 'https://api.vrchat.cloud/api/1/image/file_963999e1-abe3-4a68-a1b5-1e68ec11be62/2/1024', genre: 'Hard techno · riddim · tearout · metalstep · deathstep', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@Anal_Rampage696']], bio: 'Especialista en Hard Techno, Riddim y Tearout agresivo.' },
      { name: 'Mellana', image: 'https://api.vrchat.cloud/api/1/image/file_43052fbc-12df-4c54-85fa-e1370ca5ebbb/1/1024', genre: 'Hard dance · rawstyle · hard techno · microwave', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@oracion621']], bio: 'Melodía y contundencia en una fusión única de estilos hard y rawstyle.' },
      { name: 'ElPutoPuto', image: 'https://yt3.googleusercontent.com/GuvXjqwP0c-MRSdQt7mzddU5Lb1DEurvvUpqAJfsN3xrrfXhTC8_5qhQnidbzwgCRLvsWjsS=s160-c-k-c0x00ffffff-no-rj', genre: 'Techno · tekno · acid core · mental core · hardcore · DnB', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@ElPutoPutodj']], bio: 'Amante de la cultura free party y sonidos underground tekno/acid.' },
      { name: 'SynHaptX Fire', image: 'https://api.vrchat.cloud/api/1/image/file_49e37070-b4ef-4749-ac48-0707db2982e2/1/1024', genre: 'Dubstep · metalstep · tearout', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@synhaptxfire']], bio: 'Bajos pesados, dubstep destructivo y breaks agresivos.' },
      { name: '¦~ＰＩＫＹＥＳ~¦', image: 'https://api.vrchat.cloud/api/1/file/file_601dcfc1-bbc1-417a-b2f7-80b47a127c05/1', genre: 'Oldschool rave · hardcore · gabber · terrorcore · breakbeat · DnB', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@Pikyes']], bio: 'Rave oldschool, Gabber clásico y cultura hardcore sin concesiones.' },
      { name: 'Rylinso', image: 'https://api.vrchat.cloud/api/1/image/file_03fdcd95-4f2b-4838-bbd2-28d1372c2df1/1/256', genre: 'Bruit · breakcore · hardcore · frenchcore · hardtechno', tag: 'RESIDENT DJ', links: [['SoundCloud', 'https://soundcloud.com/rylinso']], bio: 'Propuesta Bruit oscura, poética y demoledora.' },
      { name: 'VictoriaŅice', image: 'https://api.vrchat.cloud/api/1/image/file_ee99725e-12fa-4e34-9e66-86f0fec0201f/1/256', genre: 'House · techno · breakbeat · hardstyle · dubstep · DnB · J-core', tag: 'RESIDENT DJ', links: [['YouTube', 'https://www.youtube.com/@victorianicee']], bio: 'DJ de energía cósmica y sets de alta potencia ecléctica.' },
      { name: 'DJ Luna K', image: 'https://i.imgur.com/JNOfdmG.png', genre: 'Funky house · bass house · trance · techno · hardstyle · DnB', tag: 'RESIDENT DJ', links: [['SoundCloud', 'https://soundcloud.com/dj-luna-k']], bio: 'VTuber y DJ experimentada con predilección por el Bass House y Trance.' },
      { name: 'pat fenis_', image: 'https://api.vrchat.cloud/api/1/file/file_8c9f791b-9874-4cb2-87a8-120805661f32/1/', genre: 'Hard dance · hardstyle · hard techno', tag: 'RESIDENT DJ', links: [], bio: 'Grooves electrónicos agresivos y entrega total al ritmo.' },
      { name: 'usbc', image: 'https://api.vrchat.cloud/api/1/file/file_9c89ec4e-dec2-4825-bf6f-35384dbcf33b/1/', genre: 'Hardcore · techno · drum & bass', tag: 'RESIDENT DJ', links: [], bio: 'Bajo el velo cibernético se oculta la máquina devoradora de pistas.' },
      { name: 'companda', image: 'https://i.imgur.com/E6rQFEj.png', genre: 'Hard techno · hardstyle · uptempo', tag: 'RESIDENT DJ', links: [], bio: 'Drops impactantes, técnica de cuatro canales y pura euforia.' },
      { name: 'KARASUTA', image: 'https://files.vrchat.cloud/thumbnails/file_4acc400f-1003-4392-8147-0e375616c1e7.2713dc563df6b502e53dc395aec301a6392f2c180777ab4b677347798bd1e389.1.thumbnail-256.png?Expires=1787788800&Key-Pair-Id=K3JAQ0Y971TV2&Signature=x', genre: 'Industrial · hard techno · hardcore', tag: 'RESIDENT DJ', links: [], bio: 'DJ de la Galaxia Púrpura especializado en Dubstep e Industrial.' },
      { name: 'asphyx', image: 'https://i.imgur.com/IAV8RTL.jpeg', genre: 'Schranz · hard techno · tekk · hardbounce · frenchcore · uptempo', tag: 'RESIDENT DJ', links: [], bio: 'Fusión de Schranz emocional, Tekk y Frenchcore contundente.' },
      { name: 'DarklouXxX', image: 'https://i.imgur.com/UgnngEI.png', genre: 'Hardcore · frenchcore · hardtek · hard techno · terrorcore', tag: 'RESIDENT DJ', links: [['Website', 'https://www.darkvolt.fr/']], bio: 'Trayectoria junto a leyendas de la escena Hardcore internacional.' },
      { name: 'Zhukii..', image: 'https://i.imgur.com/e9C9y0o.png', genre: 'Hardstyle · hard techno · industrial techno · uptempo · riddim', tag: 'RESIDENT DJ', links: [], bio: 'Fuerza bruta y ritmos industriales de Santa Cruz.' },
      { name: 'YGMNAniki', image: 'https://i.imgur.com/gb7WNBR.png', genre: 'Psytrance · crossbreed · skullstep · industrial · hardcore', tag: 'RESIDENT DJ', links: [['SoundCloud', 'https://soundcloud.com/ygmnaniki']], bio: 'Exploración de BPMs extremos, Crossbreed y Skullstep.' },
      { name: 'DJ Dolo✰', image: 'https://i.imgur.com/tRRlVo9.jpeg', genre: 'J-core · happy hardcore · nightcore · breakcore · speedcore', tag: 'RESIDENT DJ', links: [['SoundCloud', 'https://soundcloud.com/user-585695727']], bio: 'Sonidos veloces influenciados por Rhythm Games y la cultura J-Core.' },
      { name: 'Eternal September', image: 'https://i.imgur.com/c5r82J5.jpeg', genre: 'Underground', tag: 'RESIDENT DJ', links: [], bio: 'Sonidos oscuros e inexplorados de la escena underground.' },
      { name: 'Nohde', image: 'https://i.imgur.com/9uws00s.png', genre: 'Breakcore · EDM · dubstep · deathstep · uptempo · hardstyle · gabber', tag: 'RESIDENT DJ', links: [], bio: 'Sets impredecibles, frescos y de altísima velocidad.' }
    ];

    const rosterGrid = document.getElementById('rosterGrid');
    const rosterSearch = document.getElementById('rosterSearch');
    const profileDialog = document.getElementById('profileDialog');
    const closeDialogBtn = document.getElementById('closeDialogBtn');

    function renderRoster(items) {
      rosterGrid.innerHTML = '';
      if (items.length === 0) {
        rosterGrid.innerHTML = '<div style="grid-column:1/-1;padding:40px;text-align:center;color:var(--muted);font:500 12px var(--mono)">NO SE ENCONTRARON ARTISTAS CON ESA BÚSQUEDA</div>';
        return;
      }

      items.forEach(artist => {
        const card = document.createElement('div');
        card.className = 'dj-card reveal in-view';
        card.innerHTML = `
          <img src="${artist.image}" alt="${artist.name}" loading="lazy" onerror="this.src='logo/IMG_1574.png'">
          <div class="dj-card-content">
            <span class="dj-card-tag">${artist.tag || 'RESIDENT'}</span>
            <h3>${artist.name}</h3>
            <p>${artist.genre}</p>
          </div>
        `;

        card.addEventListener('click', () => openArtistModal(artist));
        rosterGrid.appendChild(card);
      });
    }

    function openArtistModal(artist) {
      document.getElementById('profileImage').src = artist.image;
      document.getElementById('profileName').textContent = artist.name;
      document.getElementById('profileGenre').textContent = artist.genre;
      document.getElementById('profileDescription').textContent = artist.bio || 'DJ Residente de ECLION.';
      
      const linksContainer = document.getElementById('profileLinks');
      linksContainer.innerHTML = '';
      if (artist.links && artist.links.length > 0) {
        artist.links.forEach(([label, url]) => {
          const a = document.createElement('a');
          a.className = 'profile-link-btn';
          a.href = url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = `${label} ↗`;
          linksContainer.appendChild(a);
        });
      }

      profileDialog.showModal();
      document.body.classList.add('modal-open');
    }

    closeDialogBtn.addEventListener('click', () => {
      profileDialog.close();
      document.body.classList.remove('modal-open');
    });

    profileDialog.addEventListener('click', (e) => {
      const rect = profileDialog.getBoundingClientRect();
      if (e.clientX < rect.left || e.clientX > rect.right || e.clientY < rect.top || e.clientY > rect.bottom) {
        profileDialog.close();
        document.body.classList.remove('modal-open');
      }
    });

    rosterSearch.addEventListener('input', (e) => {
      const query = e.target.value.toLowerCase().trim();
      const filtered = artistsData.filter(a => 
        a.name.toLowerCase().includes(query) || a.genre.toLowerCase().includes(query)
      );
      renderRoster(filtered);
    });

    renderRoster(artistsData);

    // --- 6. GENRE FILTER PILLS & SELECT ---
    const allGenres = ['TODOS', 'Hard Techno', 'Frenchcore', 'Hardstyle', 'Industrial', 'Breakcore', 'Dubstep', 'Tekno', 'Gabber', 'Uptempo', 'Trance'];
    const genrePillsContainer = document.getElementById('genrePills');
    const genreFilterSelect = document.getElementById('genreFilterSelect');

    allGenres.forEach(g => {
      // Select option
      const opt = document.createElement('option');
      opt.value = g;
      opt.textContent = g;
      genreFilterSelect.appendChild(opt);

      // Pill button
      const btn = document.createElement('button');
      btn.className = `genre-pill ${g === 'TODOS' ? 'active' : ''}`;
      btn.textContent = g;
      btn.addEventListener('click', () => filterByGenre(g));
      genrePillsContainer.appendChild(btn);
    });

    function filterByGenre(genre) {
      document.querySelectorAll('.genre-pill').forEach(b => {
        b.classList.toggle('active', b.textContent === genre);
      });
      genreFilterSelect.value = genre;

      if (genre === 'TODOS') {
        renderRoster(artistsData);
      } else {
        const filtered = artistsData.filter(a => a.genre.toLowerCase().includes(genre.toLowerCase()));
        renderRoster(filtered);
      }
    }

    genreFilterSelect.addEventListener('change', (e) => filterByGenre(e.target.value));

    // --- 7. MOBILE MENU & HEADER SCROLL ---
    const siteHeader = document.getElementById('siteHeader');
    const menuButton = document.getElementById('menuButton');
    const mainNav = document.getElementById('mainNav');

    window.addEventListener('scroll', () => {
      if (window.scrollY > 40) {
        siteHeader.classList.add('is-scrolled');
      } else {
        siteHeader.classList.remove('is-scrolled');
      }
    });

    menuButton.addEventListener('click', () => {
      const isOpen = mainNav.classList.toggle('is-open');
      menuButton.setAttribute('aria-expanded', isOpen);
      document.body.classList.toggle('menu-open', isOpen);
    });

    // Close menu on link click
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        mainNav.classList.remove('is-open');
        menuButton.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('menu-open');
      });
    });

    // --- 8. REVEAL ON SCROLL ---
    const revealElements = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
        }
      });
    }, { threshold: 0.1 });

    revealElements.forEach(el => observer.observe(el));

    // --- 9. MULTI-LANGUAGE SYSTEM ---
    const translations = {
      es: {
        navHome: 'Inicio', navCommunity: 'Comunidad', navGenres: 'Géneros', navMedia: 'Media', navTeam: 'Equipo',
        heroKicker: 'Comunidad Rave VRChat · Transmisión Activa', heroTitleOne: 'El ritmo no', heroTitleTwo: 'tiene fronteras.',
        heroSubtitle: 'El colectivo rave de mayor impacto en VRChat. Música electrónica de alta intensidad, escenografía virtual inmersiva y una comunidad unida por el sonido puro.',
        joinGroup: 'Unirse al Grupo VRChat', meetRoster: 'Explorar Roster DJs', nextSaturday: 'Próximo Pulso Sábado:', officialMark: 'SEÑAL UNDERGROUND · VRCHAT',
        residentDjs: 'DJs Residentes', videosLives: 'Sesiones & Directos', activeMembers: 'Miembros Activos',
        nextTransmission: 'PRÓXIMO PULSO', eclionCalendar: 'Calendario Oficial', nextPulseOne: 'La energía arranca', nextPulseTwo: 'este Sábado.',
        frequency: 'Frecuencia', everySaturday: 'Todos los Sábados · 22:00 CET', location: 'Ubicación Virtual', vrchatInstance: 'Instancia Privada VRChat',
        upcomingEvents: 'Confirmar Asistencia en Discord', ourFrequency: 'Nuestra Frecuencia', moreThanEvent: 'Más que un evento.',
        communityCopy: 'Eclion nace para dar a la escena hard un espacio auténtico, vanguardista y sin concesiones en VRChat: sonido atronador, visuales reactivos y una comunidad apasionada.',
        communityQuote: '“No se trata solo de escuchar una sesión. Se trata de adentrarte en el mundo virtual, conectar con tu gente y dejar que los BPM marquen el latido de la noche.”',
        communityCite: 'ECLION / Colectivo Rave VRChat', principleOneTitle: 'ATMÓSFERA IMMERSIVA', principleTwoTitle: 'SIN LÍMITES DE BPM', principleThreeTitle: 'COMUNIDAD SOBERANA',
        genreExplorer: 'Explorador de Géneros', findDjsByGenreOne: 'Filtra tus sonidos', findDjsByGenreTwo: 'favoritos.', officialRoster: 'Roster Oficial',
        residents: 'DJs Residentes', ofEclion: 'de Eclion.', onDemand: 'EclionVR / Bajo Demanda', energyStays: 'La energía se queda grabada.',
        mediaCopy: 'Revive las sesiones más potentes, aftermovies y momentos que hicieron temblar las instancias privadas de VRChat.', visitYouTube: 'Canal de YouTube',
        streamArchive: 'Archivo de Sesiones', moments: 'Momentos', specialEvent: 'Evento Especial', immersiveExperience: 'Experiencia Inmersiva', themedEvent: 'Evento Temático',
        theCore: 'El Núcleo', thoseWhoLight: 'Quienes encienden', founderOwnerDj: 'Fundador · Dueño · DJ', founderOwnerDjFemale: 'Fundadora · Dueña · DJ', coOwnerDj: 'Co-Dueño · DJ',
        alliedCommunities: 'Comunidades Aliadas', officialPartners: 'Partners Oficiales.', footerMessage: 'Colectivo de música electrónica underground y experiencias rave inmersivas en VRChat.'
      },
      en: {
        navHome: 'Home', navCommunity: 'Community', navGenres: 'Genres', navMedia: 'Media', navTeam: 'Team',
        heroKicker: 'VRChat Rave Community · Signal Active', heroTitleOne: 'The rhythm has', heroTitleTwo: 'no borders.',
        heroSubtitle: 'The highest impact rave collective in VRChat. High-intensity electronic music, immersive virtual staging, and a community united by pure sound.',
        joinGroup: 'Join VRChat Group', meetRoster: 'Explore DJ Roster', nextSaturday: 'Next Saturday Pulse:', officialMark: 'UNDERGROUND SIGNAL · VRCHAT',
        residentDjs: 'Resident DJs', videosLives: 'Sessions & Streams', activeMembers: 'Active Members',
        nextTransmission: 'NEXT PULSE', eclionCalendar: 'Official Calendar', nextPulseOne: 'The energy begins', nextPulseTwo: 'this Saturday.',
        frequency: 'Frequency', everySaturday: 'Every Saturday · 22:00 CET', location: 'Virtual Location', vrchatInstance: 'Private VRChat Instance',
        upcomingEvents: 'RSVP on Discord', ourFrequency: 'Our Frequency', moreThanEvent: 'More than an event.',
        communityCopy: 'Eclion gives the hard scene an authentic, avant-garde, and uncompromising space inside VRChat: thundering sound, reactive visuals, and a passionate community.',
        communityQuote: '“It is not just about listening to a set. It is about stepping into the virtual world, connecting with your people, and letting BPM set the heartbeat of the night.”',
        communityCite: 'ECLION / VRChat Rave Collective', principleOneTitle: 'IMMERSIVE ATMOSPHERE', principleTwoTitle: 'NO BPM LIMITS', principleThreeTitle: 'SOVEREIGN COMMUNITY',
        genreExplorer: 'Genre Explorer', findDjsByGenreOne: 'Filter your favorite', findDjsByGenreTwo: 'sounds.', officialRoster: 'Official Roster',
        residents: 'Resident DJs', ofEclion: 'of Eclion.', onDemand: 'EclionVR / On Demand', energyStays: 'The energy remains recorded.',
        mediaCopy: 'Relive the most powerful sets, aftermovies, and moments that shook VRChat instances.', visitYouTube: 'YouTube Channel',
        streamArchive: 'Session Archive', moments: 'Historic', specialEvent: 'Special Event', immersiveExperience: 'Immersive Experience', themedEvent: 'Themed Event',
        theCore: 'The Core', thoseWhoLight: 'Those who ignite', founderOwnerDj: 'Founder · Owner · DJ', founderOwnerDjFemale: 'Founder · Owner · DJ', coOwnerDj: 'Co-Owner · DJ',
        alliedCommunities: 'Allied Communities', officialPartners: 'Official Partners.', footerMessage: 'Underground electronic music collective and immersive rave experiences in VRChat.'
      }
    };

    const languageSelect = document.getElementById('languageSelect');
    languageSelect.addEventListener('change', (e) => {
      const lang = e.target.value;
      const dict = translations[lang] || translations.es;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (dict[key]) el.textContent = dict[key];
      });
    });
  </script>
</body>
</html>
